{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claim Ledger",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "claim_id",
      "claim",
      "claim_type",
      "evidence_level",
      "status",
      "source_ids"
    ],
    "properties": {
      "claim_id": {
        "type": "string",
        "pattern": "^CLM-[A-Z0-9_-]+$"
      },
      "claim": {
        "type": "string",
        "minLength": 1
      },
      "claim_type": {
        "enum": [
          "REAL_SELLING_POINT",
          "PERCEIVED_BENEFIT",
          "EMOTIONAL_VALUE",
          "PENDING_CLAIM",
          "PROHIBITED_CLAIM"
        ]
      },
      "evidence_level": {
        "enum": [
          "A",
          "B",
          "C",
          "NONE"
        ]
      },
      "source_ids": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      },
      "allowed_scope": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "prohibited_scope": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "status": {
        "enum": [
          "ACTIVE",
          "CONDITIONAL",
          "HOLD",
          "BLOCKED"
        ]
      }
    },
    "additionalProperties": true
  }
}