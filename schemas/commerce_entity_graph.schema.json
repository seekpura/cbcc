{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "entities",
    "relations"
  ],
  "properties": {
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entity_id",
          "entity_type"
        ],
        "properties": {
          "entity_id": {
            "type": "string"
          },
          "entity_type": {
            "enum": [
              "PRODUCT",
              "SKU",
              "CLAIM",
              "SOURCE",
              "AUDIENCE",
              "MARKET",
              "PLATFORM",
              "SURFACE",
              "ASSET",
              "EXPERIMENT"
            ]
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "relation"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "relation": {
            "type": "string"
          }
        }
      }
    }
  }
}