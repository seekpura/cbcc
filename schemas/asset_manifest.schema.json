{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Asset Manifest",
  "type": "object",
  "required": [
    "asset_id",
    "asset_name",
    "status",
    "platform",
    "market",
    "consumer_question",
    "strategic_job",
    "production_mode",
    "product_fidelity",
    "priority",
    "source_ids",
    "claim_ids"
  ],
  "properties": {
    "asset_id": {
      "type": "string",
      "pattern": "^(AST-[A-Z0-9]{10}|(LST|VID|UGC|AD|DOC)-[0-9]{2,3})$"
    },
    "asset_name": {
      "type": "string",
      "minLength": 1
    },
    "asset_type": {
      "enum": [
        "IMAGE",
        "VIDEO",
        "UGC",
        "AD",
        "DOCUMENTATION"
      ]
    },
    "status": {
      "enum": [
        "ACTIVATE",
        "CONDITIONAL",
        "HOLD",
        "BLOCKED"
      ]
    },
    "platform": {
      "type": "string"
    },
    "market": {
      "type": "string"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "consumer_question": {
      "type": "string",
      "minLength": 1
    },
    "strategic_job": {
      "type": "string",
      "minLength": 1
    },
    "funnel_stage": {
      "type": "string"
    },
    "race_stage": {
      "enum": [
        "RESEARCH",
        "ACTION",
        "COMMUNICATION",
        "EVALUATION"
      ]
    },
    "jtbd_role": {
      "type": "string"
    },
    "production_mode": {
      "enum": [
        "REAL_PHOTO",
        "REAL_PRODUCT_COMPOSITE",
        "AI_ENVIRONMENT_REAL_PRODUCT",
        "AI_HUMAN_REAL_PRODUCT",
        "AI_GENERATIVE",
        "GRAPHIC_DESIGN",
        "THREE_D",
        "VIDEO",
        "DOCUMENTATION"
      ]
    },
    "product_fidelity": {
      "enum": [
        "LOCKED_PIXEL",
        "REFERENCE_CONSTRAINED",
        "GENERATIVE"
      ]
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "listing_reference": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "success_metric": {
      "type": "string"
    },
    "editable_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "surface": {
      "type": [
        "string",
        "null"
      ]
    },
    "family": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}