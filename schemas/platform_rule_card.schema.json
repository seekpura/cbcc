{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "platform",
    "status"
  ],
  "properties": {
    "platform": {
      "type": "string"
    },
    "market": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "VERIFIED",
        "REVERIFY_REQUIRED"
      ]
    },
    "verified_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "sources": {
      "type": "array"
    },
    "rules": {
      "type": "object"
    }
  }
}