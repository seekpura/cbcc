{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "judgments"
  ],
  "properties": {
    "judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "statement",
          "status"
        ],
        "properties": {
          "statement": {
            "type": "string"
          },
          "status": {
            "enum": [
              "VERIFIED",
              "LIKELY",
              "ASSUMPTION",
              "PENDING"
            ]
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}