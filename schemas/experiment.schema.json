{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experiment Plan",
  "type": "object",
  "required": [
    "experiment_id",
    "root_cause",
    "baseline",
    "hypothesis",
    "change_scope",
    "target_metric",
    "test_window"
  ],
  "properties": {
    "experiment_id": {
      "type": "string"
    },
    "root_cause": {
      "type": "string",
      "minLength": 1
    },
    "baseline": {
      "type": "object"
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "change_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "locked_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_metric": {
      "type": "string",
      "minLength": 1
    },
    "test_window": {
      "type": "string",
      "minLength": 1
    },
    "external_confounds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}