 def _jdump(x): return json.dumps(x,ensure_ascii=False,indent=2)
 
 
+def _operator_text(value: Any, default: str = '') -> str:
+    """Render a structured multilingual semantic value for Chinese-first operator text.
+
+    Canonical business objects may carry locale-keyed mappings. Human guidance needs one readable
+    string, while machine manifests must preserve the original structured value.
+    """
+    if value in (None, '', [], {}):
+        return default
+    if isinstance(value, dict):
+        for key in ('zh-CN', 'zh', 'cn', 'CN', 'chinese', 'en', 'EN'):
+            candidate=value.get(key)
+            if candidate not in (None, '', [], {}):
+                return _operator_text(candidate, default)
+        return json.dumps(value, ensure_ascii=False, sort_keys=True, default=str)
+    if isinstance(value, (list, tuple, set, frozenset)):
+        return '；'.join(_operator_text(item) for item in value if item not in (None, '', [], {})) or default
+    return str(value)
+
+
+def _semantic_text_values(value: Any) -> set[str]:
+    """Return hashable textual leaves for semantic equality checks without destroying structure."""
+    if value in (None, '', [], {}):
+        return set()
+    if isinstance(value, dict):
+        out=set()
+        for child in value.values():
+            out.update(_semantic_text_values(child))
+        return out
+    if isinstance(value, (list, tuple, set, frozenset)):
+        out=set()
+        for child in value:
+            out.update(_semantic_text_values(child))
+        return out
+    return {str(value)}
+
