--- /dev/null
+++ b/tests/test_v0673_chinese_delivery_closure.py
@@ -0,0 +1,82 @@
+from __future__ import annotations
+
+from pathlib import Path
+
+from cbcc.human_language_delivery import normalize_upload_center, audit_human_language_delivery
+from cbcc.global_chinese_interpretation import normalize_global_chinese_interpretation
+from cbcc.final_chinese_interpretation_audit import audit_final_chinese_interpretation
+from cbcc.video_creator import build_video_creator_plan
+
+
+def _center(rows):
+    return {
+        'delivery_language': {'locale': 'zh-CN'},
+        'target': {'delivery_locale': 'zh-CN', 'locale': 'ms-MY'},
+        'task_scope': {'listing_active': True},
+        'copy_center': rows,
+        'preserved_listing_fields': [],
+        'localized_copy': [],
+    }
+
+
+def test_mature_listing_fields_have_semantic_chinese_titles(tmp_path: Path):
+    center = normalize_upload_center(_center([
+        {'field': 'selling_points', 'label': 'selling_points', 'value': 'Oil-control care', 'delivery_translation': '控油护理'},
+        {'field': 'specification', 'label': 'specification', 'value': '30 g / 1.01 oz'},
+        {'field': 'key_ingredients', 'label': 'key_ingredients', 'value': 'Niacinamide + Salicylic Acid', 'delivery_translation': '烟酰胺 + 水杨酸'},
+    ]))
+    labels = {r['field']: r['label'] for r in center['copy_center']}
+    assert labels == {
+        'selling_points': '卖点短句',
+        'specification': '规格',
+        'key_ingredients': '关键成分',
+    }
+    audit = audit_human_language_delivery(tmp_path, center)
+    assert not [x for x in audit['issues'] if x['code'] == 'LISTING_FIELD_TITLE_CN_SEMANTIC_MISSING'], audit
+
+
+def test_compound_measurement_spec_is_language_neutral_across_listing_projections(tmp_path: Path):
+    row = {
+        'field': 'specification', 'label': 'specification', 'value': '30 g / 1.01 oz',
+        # Same numeric/unit form is intentionally allowed as the zh-CN delivery value because it is language-neutral.
+        'delivery_translation': '30 g / 1.01 oz',
+    }
+    center = _center([dict(row)])
+    center['localized_copy'] = [dict(row, locale='en-MY')]
+    center['preserved_listing_fields'] = [dict(row, locale='en-MY')]
+    center = normalize_global_chinese_interpretation(normalize_upload_center(center))
+    audit = audit_final_chinese_interpretation(tmp_path, center)
+    bad = [x for x in audit['issues'] if x.get('field') == 'specification' and 'WITHOUT_CN_COMPANION' in x.get('code', '')]
+    assert not bad, audit
+
+
+def test_video_human_hook_uses_authored_visible_copy_not_internal_consumer_question():
+    assets = [{
+        'asset_id': 'V01', 'family': 'VIDEO', 'surface': 'PDP_VIDEO',
+        'consumer_question': 'How can a 15-second creator video explain identity, formula and routine without claiming results?',
+        'decision_intent': 'RELEVANCE',
+        'incremental_information': 'Explain identity, formula and routine without overclaiming.',
+        'visible_copy': {
+            'target_copy': 'KAWAL MINYAK · HIDRASI RINGAN',
+            'english_baseline': 'OIL-CARE · LIGHTWEIGHT HYDRATION',
+            'chinese_meaning': '油脂护理 · 轻盈补水。',
+        },
+        'asset_art_direction': {
+            'visible_copy': {
+                'target_copy': 'KAWAL MINYAK · HIDRASI RINGAN',
+                'english_baseline': 'OIL-CARE · LIGHTWEIGHT HYDRATION',
+                'chinese_meaning': '油脂护理 · 轻盈补水。',
+            }
+        },
+    }]
+    plan = build_video_creator_plan(
+        'K01',
+        [{'family': 'VIDEO', 'surface': 'PDP_VIDEO', 'curation_job': 'creator video'}],
+        [],
+        {'primary_locale': 'ms-MY', 'visible_copy_locales': ['ms-MY'], 'delivery_locale': 'zh-CN'},
+        assets=assets,
+    )
+    row = plan['assets'][0]
+    assert row['shopper_question'].startswith('How can a 15-second creator video')
+    assert row['hook'] == 'KAWAL MINYAK · HIDRASI RINGAN'
+    assert row['hook_cn'] == '油脂护理 · 轻盈补水。'
