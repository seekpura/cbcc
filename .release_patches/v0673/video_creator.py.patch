+def _authored_visible_hook(source:dict[str,Any])->tuple[Any,Any]:
+    """Return already-authored market-facing hook + Chinese meaning without translating."""
+    candidates=[]
+    if isinstance(source.get('visible_copy'),dict): candidates.append(source.get('visible_copy'))
+    art=source.get('asset_art_direction') if isinstance(source.get('asset_art_direction'),dict) else {}
+    if isinstance(art.get('visible_copy'),dict): candidates.append(art.get('visible_copy'))
+    for copy in candidates:
+        hook=copy.get('target_copy') or copy.get('target_market_copy') or copy.get('headline') or copy.get('primary_copy')
+        if hook not in (None,'',[],{}):
+            hook_cn=copy.get('chinese_meaning') or copy.get('delivery_translation_zh') or copy.get('delivery_translation') or copy.get('zh') or copy.get('zh-CN')
+            return hook,hook_cn
+    return None,None
