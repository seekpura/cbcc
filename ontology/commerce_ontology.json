  "constraints": [
    {
      "id": "C-TRUTH-001",
      "scope": "claim",
      "statement": "Hard claims retain source/evidence lineage before publication-sensitive execution.",
      "type": "evidence"
    },
    {
      "id": "C-STRAT-001",
      "scope": "strategy",
      "statement": "Every major strategy decision carries WHY plus consumer/platform/culture/business logic where relevant.",
      "type": "quality"
    },
    {
      "id": "C-ASSET-001",
      "scope": "asset",
      "statement": "Asset count is dynamic and justified by shopper questions and surface jobs.",
      "type": "architecture"
    },
    {
      "id": "C-ASSET-002",
      "scope": "asset-package",
      "statement": "Every dynamic asset package retains the complete 00_asset_manifest.yaml through 11_strategy_authority_trace.json contract; non-applicable contracts remain explicit placeholders rather than disappearing.",
      "type": "compatibility"
    },
    {
      "id": "C-REV-001",
      "scope": "local-revision",
      "statement": "Only approved fields may change during a local revision.",
      "type": "execution"
    },
    {
      "id": "C-PLAT-001",
      "scope": "platform",
      "statement": "Family planning capability does not imply exact site/category submission readiness.",
      "type": "evidence"
    },
    {
      "id": "C-CULT-001",
      "scope": "culture",
      "statement": "Race/ethnicity/religion may inform contextual adaptation but not unsupported behavioral stereotypes.",
      "type": "quality"
    },
    {
      "id": "C-PHOTO-001",
      "scope": "photography",
      "statement": "Photography choices preserve product identity/color and explain the commercial role of key choices.",
      "type": "quality"
    },
    {
      "id": "C-TEST-001",
      "scope": "experiment",
      "statement": "Statistical significance alone is not causal attribution when multiple variables changed.",
      "type": "measurement"
    },
    {
      "id": "C-STRAT-002",
      "scope": "strategy",
      "statement": "Market calculations must be interpreted into a commercial implication before they appear as recommendations.",
      "type": "quality"
    },
    {
      "id": "C-STRAT-003",
      "scope": "positioning",
      "statement": "A strategy locks one primary conversion proposition before secondary reasons and trust layers.",
      "type": "architecture"
    },
    {
      "id": "C-LIST-001",
      "scope": "listing",
      "statement": "Every listing field has a distinct decision job and source/claim lineage where relevant.",
      "type": "quality"
    },
    {
      "id": "C-ASSET-003",
      "scope": "asset",
      "statement": "Each asset records consumer question, strategic job, surface need, incremental information, business hypothesis, purchase barrier/belief target where relevant, and success metric.",
      "type": "architecture"
    },
    {
      "id": "C-MEAS-002",
      "scope": "measurement",
      "statement": "Advertising and feedback diagnostics route revisions to the causal layer rather than triggering broad redesign by default.",
      "type": "measurement"
    },
    {
      "id": "C-MKT-001",
      "scope": "strategy",
      "statement": "Market whitespace, price valleys and competitor clusters are hypotheses until cross-checked against demand, product fit, unit economics and platform execution evidence.",
      "type": "quality"
    },
    {
      "id": "C-OFFER-001",
      "scope": "strategy",
      "statement": "Coupon, affiliate commission and paid media consume a shared contribution pool; channel budgets are not independent percentages.",
      "type": "economics"
    },
    {
      "id": "C-LIST-002",
      "scope": "listing",
      "statement": "Localization is transcreation: preserve truth, claim strength and message hierarchy while adapting natural language, search intent and surface constraints.",
      "type": "quality"
    },
    {
      "id": "C-ASSET-004",
      "scope": "asset",
      "statement": "No asset exists only to fill a slot; repeated consumer questions require a distinct surface need or incremental information and a testable business hypothesis.",
      "type": "architecture"
    },
    {
      "id": "C-MEAS-003",
      "scope": "measurement",
      "statement": "Attribution metrics do not establish incrementality; scale decisions distinguish observed attribution from causal evidence.",
      "type": "measurement"
    },
    {
      "id": "C-COMP-001",
      "scope": "strategy",
      "statement": "Competitor differentiation decisions distinguish observed listing/offer/proof evidence from interpretation and join review themes only through source-bounded labels.",
      "type": "evidence"
    },
    {
      "id": "C-PORT-001",
      "scope": "strategy",
      "statement": "Multi-SKU portfolio strategy reviews overlap/cannibalization and requires each price step or SKU to earn a distinct buyer, lifecycle, channel or value role.",
      "type": "economics"
    },
    {
      "id": "C-LOC-001",
      "scope": "listing",
      "statement": "Locale authoring preserves product identity, numerical facts, claim strength and decision job while allowing native syntax, order, hook and CTA adaptation.",
      "type": "quality"
    },
    {
      "id": "C-RES-001",
      "scope": "strategy",
      "statement": "Market/competitor/customer research conclusions preserve source IDs, time scope and sampling/representativeness boundaries; sample size alone never proves representativeness.",
      "type": "evidence"
    },
    {
      "id": "C-PORT-002",
      "scope": "measurement",
      "statement": "Observed cross-shopping, switching and cohort differences are descriptive evidence; causal cannibalization/incrementality requires a valid counterfactual or experiment design.",
      "type": "measurement"
    },
    {
      "id": "C-LOC-002",
      "scope": "listing",
      "statement": "Localized copy becomes APPROVED_FINAL only after deterministic hard checks and explicit native fluency, claim-equivalence, platform-fit and culture-fit approval.",
      "type": "quality"
    },
    {
      "id": "C-PLAT-002",
      "scope": "strategy",
      "statement": "Platform reuse shares Strategy Authority and evidence, not identical copy, beat sequence, information density or CTA across TikTok Shop, Shopee, Amazon and DTC.",
      "type": "architecture"
    },
    {
      "id": "C-EVIDENCE-DEDUP",
      "scope": "strategy",
      "statement": "Cross-source content equality must not be auto-deduplicated; exact deterministic dedup is opt-in and source-bounded."
    },
    {
      "id": "C-SWITCH-RATE",
      "scope": "strategy",
      "statement": "Directional switch rate requires an explicit eligible-from denominator; descriptive switching is not causal cannibalization."
    },
    {
      "id": "C-COPY-VERSION",
      "scope": "listing",
      "statement": "A professional review approves only the current copy version it explicitly reviewed when version history is present."
    },
    {
      "id": "C-ASSET-PHOTO-WHY",
      "scope": "photography",
      "statement": "Photography parameters should be justified at asset level by decision visibility, CMF/material truth, surface and business hypothesis."
    },
    {
      "id": "C-ING-002",
      "scope": "strategy",
      "statement": "Incremental adapters may carry forward prior rows only when refresh mode is explicitly INCREMENTAL_BATCH; semantic-near-duplicate detection is review-only and never silently deletes evidence.",
      "type": "evidence"
    },
    {
      "id": "C-EXP-003",
      "scope": "experiment",
      "statement": "Experiment scale decisions review assignment, pre-period balance, MDE/power, contamination and interference before interpreting outcome significance or lift.",
      "type": "measurement"
    },
    {
      "id": "C-COPY-003",
      "scope": "listing",
      "statement": "Host/model authoring responses create new draft CopyVersion records only; they never create or inherit professional approval.",
      "type": "quality"
    },
    {
      "id": "C-SURF-002",
      "scope": "asset",
      "statement": "Each active surface compiles an executable production contract while exact submission limits remain sourced from current platform authority.",
      "type": "architecture"
    },
    {
      "id": "C-PHOTO-003",
      "scope": "photography",
      "statement": "Shot-level lighting choices are justified by supplied CMF/material behavior and consumer decision visibility; unknown finish/material behavior remains provisional rather than invented.",
      "type": "quality"
    },
    {
      "id": "C-ADAPTER-003",
      "scope": "strategy",
      "statement": "Cursor/checkpoint metadata records resumability only; it never proves complete marketplace/search/review coverage.",
      "type": "evidence"
    },
    {
      "id": "C-EXP-004",
      "scope": "experiment",
      "statement": "Cluster, geo, CUPED and sequential designs require design-appropriate inference; naive individual z-tests or repeated peeking do not establish valid causal evidence.",
      "type": "measurement"
    },
    {
      "id": "C-COPY-004",
      "scope": "listing",
      "statement": "Explicit terminology memory constrains locale copy across fields; forbidden variants or required-term violations can block Final Copy, while non-blocking variation requires review.",
      "type": "quality"
    },
    {
      "id": "C-PROD-004",
      "scope": "asset-package",
      "statement": "Provider jobs bind the frozen surface/platform/photography contracts by package and contract hashes; contract changes require a new package/job.",
      "type": "architecture"
    },
    {
      "id": "C-PHOTO-004",
      "scope": "photography",
      "statement": "Prelight records actual lighting geometry, exposure relationship, polarization choice and color reference before repeated production capture; missing numeric ratios are measured, not invented.",
      "type": "quality"
    },
    {
      "id": "C-CATEGORY-SPECIFICITY",
      "scope": "strategy",
      "rule": "Different commerce categories must not inherit one fixed asset sequence or photography recipe; category profiles may guide decisions but never invent product facts or claims."
    },
    {
      "id": "C-CAT-COMMERCE-001",
      "scope": "strategy",
      "statement": "Category commerce profiles may reorder objections, proof, offers, messages and content cadence, but must not create unsupported product facts, policies, sensory claims, compatibility, performance or service promises.",
      "type": "truth-boundary"
    },
    {
      "id": "C-EVIDENCE-PRIOR-01",
      "scope": "strategy",
      "rule": "Product Truth/current verified policy outrank market evidence; market evidence outranks category prior for priority/sequence only and may not create product facts or claims."
    },
    {
      "id": "C-OFFER-EVIDENCE-01",
      "scope": "strategy",
      "rule": "Observational promo response, bundle affinity and repeat timing may support a test candidate but do not establish causal incrementality or an optimal offer."
    },
    {
      "id": "C-PROOF-CONDITION-01",
      "scope": "claim",
      "rule": "Each proof type must declare evidence conditions and do-not-infer boundaries before it is treated as publishable proof."
    },
    {
      "id": "C-EVIDENCE-QUALITY-01",
      "scope": "strategy",
      "rule": "External market/search/review/competitor evidence must be quality-weighted by documented freshness, traceability, representativeness metadata, scope match, explicit source quality and agreement/conflict before it reorders a category prior."
    },
    {
      "id": "C-MARKET-FIT-01",
      "scope": "asset",
      "rule": "Market/search/review/competitor observations may create fit-review tasks but may not create own-product claims or dynamic asset jobs until Product Truth fit is explicitly confirmed."
    },
    {
      "id": "C-REVISION-LOCAL-01",
      "scope": "local-revision",
      "rule": "Ads/feedback diagnostics must route to the smallest plausible strategy layer and freeze unrelated layers; no broad redesign is auto-applied from a single symptom."
    },
    {
      "id": "C-LOCAL-REVISION-IMMUTABLE-01",
      "scope": "local-revision",
      "rule": "A local revision must not mutate the parent 00–11 asset package; it must retain the parent package hash, explicit allowed_fields and separate revised-output lineage."
    },
    {
      "id": "C-LEARNING-CAUSAL-01",
      "scope": "learning",
      "rule": "Before/after movement is descriptive by default. Causal credit for a local revision requires explicit valid causal evidence; otherwise learning may recommend keep/rollback/continue-test without causal attribution."
    },
    {
      "id": "C-LEARNING-LOCALITY-01",
      "scope": "learning",
      "rule": "Post-production learning may update only the evidence-implicated strategy layers; Product Truth and unrelated frozen layers remain authoritative unless separate evidence implicates them."
    }
  ],
  "processes": [
    {
      "id": "P-STRATEGY",
      "name": "Strategy Authoring",
      "stages": [
        "Information Audit",
        "Product Truth & Value Ladder",
        "Market / Competitor / Customer Understanding",
        "Product / SKU / Offer Strategy",
        "Positioning / Value Proposition",
        "Message Architecture",
        "RACE / 4P / Funnel",
        "Listing / Search Architecture",
        "Platform Content Strategy",
        "Creative / Visual Strategy",
        "Photography / CMF",
        "Dynamic Asset Architecture",
        "Asset Compiler",
        "Production",
        "Measurement / Feedback / Iteration"
      ]
    },
